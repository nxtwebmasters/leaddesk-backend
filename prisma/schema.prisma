generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum OrgRole {
  OWNER
  ORG_ADMIN
  DIRECTOR
  MANAGER
  MEMBER
  GUEST_STAKEHOLDER
  COMPLIANCE_AUDITOR
}

enum TaskStatus {
  INBOX
  PLANNED
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  TASK
  DELEGATED
  FOLLOW_UP
  PERSONAL
}

enum InboxItemType {
  TASK
  NOTE
  REMINDER
  MEETING
  DISCUSSION
  IDEA
  DECISION
  FOLLOW_UP
}

enum InboxItemStatus {
  NEW
  PROCESSED
  DISMISSED
}

enum FollowUpStatus {
  OPEN
  WAITING
  COMPLETED
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

enum CalendarEventType {
  MEETING
  PERSONAL
  TASK
  REMINDER
  OTHER
}

// ==========================================
// MODELS
// ==========================================

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  passwordHash   String
  displayName    String
  timezone       String          @default("Asia/Karachi")
  isActive       Boolean         @default(true)
  externalId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  refreshTokens  RefreshToken[]
  inboxItems     InboxItem[]
  tasks          Task[]
  followUps      FollowUp[]
  meetings       Meeting[]
  notes          Note[]
  contacts       Contact[]
  calendarEvents    CalendarEvent[]
  reminders         Reminder[]
  attachments       Attachment[]
  pushSubscriptions PushSubscription[]
  notifications     AppNotification[]
  decisions         Decision[]
  orgMemberships    OrgMembership[]
  ledTeams          Team[]              @relation("TeamLead")
  devexPulses       DevExPulse[]
  auditLogs         AuditLog[]
  complianceExports ComplianceExport[]
  ledAgendas        OneOnOneAgenda[]    @relation("AgendaLead")
  memberAgendas     OneOnOneAgenda[]    @relation("AgendaMember")
  quarterlyReviews  QuarterlyReview[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model InboxItem {
  id                  String          @id @default(uuid()) @db.Uuid
  content             String          @db.Text
  type                InboxItemType   @default(NOTE)
  status              InboxItemStatus @default(NEW)
  source              String?         @default("WEB")
  idempotencyKey      String?         @unique
  convertedEntityType String?
  convertedEntityId   String?         @db.Uuid
  capturedAt          DateTime        @default(now())
  processedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  userId              String          @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, capturedAt])
  @@map("inbox_items")
}

model Task {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  description    String?         @db.Text
  status         TaskStatus      @default(INBOX)
  priority       Priority        @default(MEDIUM)
  type           TaskType        @default(TASK)
  dueAt          DateTime?
  completedAt    DateTime?
  assigneeName   String?
  assigneeEmail  String?
  sourceUrl      String?
  sourceSystem   String?
  externalKey    String?         // e.g. "ENG-1024" or "LIN-42"
  lastSyncedAt   DateTime?
  sortOrder      Int             @default(0)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  contactId      String?         @db.Uuid
  contact        Contact?        @relation("ContactTasks", fields: [contactId], references: [id], onDelete: SetNull)

  workspaceId    String?         @db.Uuid
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  subtasks       Subtask[]
  followUps      FollowUp[]
  meetingActions MeetingAction[]
  tags           TaskTag[]
  reminders      Reminder[]
  attachments    Attachment[]

  @@index([userId, status, dueAt])
  @@index([userId, priority])
  @@index([userId, updatedAt])
  @@map("tasks")
}

model Subtask {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  isCompleted Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskId      String   @db.Uuid
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@map("subtasks")
}

model FollowUp {
  id              String         @id @default(uuid()) @db.Uuid
  contactName     String
  organization    String?
  subject         String
  context         String?        @db.Text
  expectedOutcome String?        @db.Text
  status          FollowUpStatus @default(OPEN)
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contactId       String?        @db.Uuid
  contact         Contact?       @relation("ContactFollowUps", fields: [contactId], references: [id], onDelete: SetNull)

  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId          String?        @db.Uuid
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  meetingId       String?        @db.Uuid
  meeting         Meeting?       @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId, status, nextFollowUpAt])
  @@map("follow_ups")
}

model Meeting {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  description    String?         @db.Text
  status         MeetingStatus   @default(SCHEDULED)
  startedAt      DateTime
  endedAt        DateTime?
  location       String?
  meetingUrl     String?
  participants   Json?
  notesMarkdown  String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspaceId    String?         @db.Uuid
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  actions        MeetingAction[]
  decisions      Decision[]
  followUps      FollowUp[]
  reminders      Reminder[]
  attachments    Attachment[]

  @@index([userId, startedAt])
  @@map("meetings")
}

model MeetingAction {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  ownerName   String?
  dueAt       DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meetingId   String    @db.Uuid
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  taskId      String?   @db.Uuid
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("meeting_actions")
}

model Decision {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?  @db.Text
  decidedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  meetingId   String?  @db.Uuid
  meeting     Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, decidedAt])
  @@index([userId, decidedAt])
  @@map("decisions")
}

model Note {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  content     String       @db.Text
  isPinned    Boolean      @default(false)
  sourceUrl   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspaceId String?      @db.Uuid
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags        NoteTag[]
  attachments Attachment[]

  @@index([userId, updatedAt])
  @@map("notes")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now())

  tasks     TaskTag[]
  notes     NoteTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @db.Uuid
  tagId  String @db.Uuid

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model NoteTag {
  noteId String @db.Uuid
  tagId  String @db.Uuid

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

model CalendarEvent {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  description String?           @db.Text
  eventType   CalendarEventType @default(OTHER)
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean           @default(false)
  sourceUrl   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@map("calendar_events")
}

model Reminder {
  id        String         @id @default(uuid()) @db.Uuid
  title     String
  remindAt  DateTime
  status    ReminderStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime       @default(now())

  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId    String?        @db.Uuid
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  meetingId String?        @db.Uuid
  meeting   Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([userId, status, remindAt])
  @@map("reminders")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  storageKey String   @unique
  createdAt  DateTime @default(now())

  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId     String?  @db.Uuid
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  noteId     String?  @db.Uuid
  note       Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  meetingId  String?  @db.Uuid
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("attachments")
}

model Contact {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  role         String?    // e.g. Senior Frontend Dev, QA Lead, DevOps Engineer, Client
  organization String?    // e.g. Internal Team, Cloud Team, Client Org
  email        String?
  phone        String?
  handle       String?    // @slack or @teams username
  notes        String?    @db.Text
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks        Task[]     @relation("ContactTasks")
  followUps    FollowUp[] @relation("ContactFollowUps")

  @@index([userId, name])
  @@map("contacts")
}

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AppNotification {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String   @db.Text
  type      String   @default("GENERAL") // DAILY_KICKOFF, MEETING_ALERT, FOLLOWUP_SWEEP, REMINDER, GENERAL
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("app_notifications")
}

// ==========================================
// V3 ENTERPRISE MULTI-TENANCY & RBAC
// ==========================================

model Organization {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String          @unique
  domain         String?
  logoUrl        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Enterprise SAML 2.0 Single Sign-On
  ssoEnabled     Boolean         @default(false)
  ssoProvider    String?         // 'OKTA' | 'AZURE_AD' | 'GOOGLE' | 'GENERIC_SAML'
  ssoEntityId    String?         // IdP Entity ID / Issuer URI
  ssoLoginUrl    String?         // IdP Single Sign-On URL
  ssoAcsUrl      String?         // SP Assertion Consumer Service URL
  ssoCert        String?         @db.Text // IdP X.509 Public Certificate
  ssoMetadataUrl String?         // IdP Metadata XML URL
  enforceSso     Boolean         @default(false)
  allowedDomains String[]        @default([])

  // Enterprise SCIM 2.0 User Provisioning
  scimEnabled    Boolean         @default(false)
  scimApiKey     String?         @unique

  workspaces     Workspace[]
  memberships    OrgMembership[]
  invitations    OrgInvitation[]
  integrations   Integration[]
  pullRequests   PullRequestWatch[]
  integrationEvents IntegrationEvent[]
  deployments    Deployment[]
  incidents      Incident[]
  devexPulses    DevExPulse[]
  objectives     Objective[]
  auditLogs      AuditLog[]
  retentionPolicies RetentionPolicy[]
  complianceExports ComplianceExport[]
  semanticMemories  SemanticMemory[]
  oneOnOneAgendas   OneOnOneAgenda[]
  quarterlyReviews  QuarterlyReview[]

  @@map("organizations")
}

model Workspace {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  slug           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orgId          String          @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  parentId       String?         @db.Uuid
  parent         Workspace?      @relation("WorkspaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Workspace[]     @relation("WorkspaceHierarchy")

  teams          Team[]
  tasks          Task[]
  meetings       Meeting[]
  notes          Note[]
  integrations   Integration[]
  deployments    Deployment[]
  objectives     Objective[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("workspaces")
}

model Team {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspaceId    String          @db.Uuid
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  leadUserId     String?         @db.Uuid
  leadUser       User?           @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)

  memberships    TeamMembership[]
  devexPulses    DevExPulse[]

  @@index([workspaceId])
  @@map("teams")
}

model OrgMembership {
  id             String          @id @default(uuid()) @db.Uuid
  role           OrgRole         @default(MEMBER)
  title          String?
  department     String?
  isActive       Boolean         @default(true)
  joinedAt       DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orgId          String          @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  reportsToId    String?         @db.Uuid
  reportsTo      OrgMembership?  @relation("ReportingLine", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports  OrgMembership[] @relation("ReportingLine")

  teamMemberships TeamMembership[]

  @@unique([orgId, userId])
  @@index([orgId, role])
  @@index([reportsToId])
  @@map("org_memberships")
}

model TeamMembership {
  id             String          @id @default(uuid()) @db.Uuid
  isTechLead     Boolean         @default(false)
  joinedAt       DateTime        @default(now())

  teamId         String          @db.Uuid
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  membershipId   String          @db.Uuid
  orgMembership  OrgMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@map("team_memberships")
}

model OrgInvitation {
  id             String          @id @default(uuid()) @db.Uuid
  email          String
  role           OrgRole         @default(MEMBER)
  token          String          @unique
  expiresAt      DateTime
  invitedById    String          @db.Uuid
  createdAt      DateTime        @default(now())

  orgId          String          @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@map("org_invitations")
}

// ==========================================
// V3 PHASE 3: TOOLCHAIN EVENT MESH MODELS
// ==========================================

enum IntegrationProvider {
  GITHUB
  GITLAB
  JIRA
  LINEAR
  SLACK
  TEAMS
}

enum PrStatus {
  OPEN
  MERGED
  CLOSED
  DRAFT
}

enum EventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model Integration {
  id             String               @id @default(uuid()) @db.Uuid
  provider       IntegrationProvider
  name           String               // e.g. "Acme Core GitHub", "Platform Jira Cloud"
  isEnabled      Boolean              @default(true)
  webhookSecret  String?              // Secret used for HMAC-SHA256 signature verification
  apiKey         String?              // Outbound API token / OAuth Bearer token
  externalOrg    String?              // External org or workspace ID (e.g. GitHub org, Slack team)
  config         Json?                // Provider-specific config (e.g. { prSlaHours: 24, channelId: "C12345" })
  lastSyncAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  orgId          String               @db.Uuid
  organization   Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  workspaceId    String?              @db.Uuid
  workspace      Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  events         IntegrationEvent[]
  pullRequests   PullRequestWatch[]

  @@unique([orgId, provider, name])
  @@index([orgId, provider])
  @@map("integrations")
}

model PullRequestWatch {
  id                   String              @id @default(uuid()) @db.Uuid
  provider             IntegrationProvider @default(GITHUB)
  repository           String              // e.g. "acme/payment-gateway"
  prNumber             Int
  title                String
  prUrl                String
  authorUsername       String
  authorEmail          String?
  status               PrStatus            @default(OPEN)
  reviewState          String?             // 'PENDING' | 'APPROVED' | 'CHANGES_REQUESTED'
  requestedReviewers   String[]            @default([])
  openedAt             DateTime
  firstReviewAt        DateTime?
  reviewLatencyMinutes Int?
  mergedAt             DateTime?
  closedAt             DateTime?
  isStalled            Boolean             @default(false)
  slaBreachedAt        DateTime?
  lastActivityAt       DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  integrationId        String              @db.Uuid
  integration          Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  orgId                String              @db.Uuid
  organization         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([integrationId, repository, prNumber])
  @@index([orgId, status, isStalled])
  @@index([orgId, openedAt])
  @@map("pull_request_watches")
}

model IntegrationEvent {
  id             String               @id @default(uuid()) @db.Uuid
  provider       IntegrationProvider
  eventType      String               // e.g. "pull_request.opened", "jira:issue_updated", "slack.command"
  deliveryId     String?              // External header ID (e.g. X-GitHub-Delivery)
  payload        Json
  status         EventStatus          @default(RECEIVED)
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime             @default(now())

  integrationId  String?              @db.Uuid
  integration    Integration?         @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  orgId          String               @db.Uuid
  organization   Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, provider, createdAt])
  @@index([deliveryId])
  @@map("integration_events")
}

// ==========================================
// V3 PHASE 4: ENGOPS & DORA METRICS MODELS
// ==========================================

enum DeploymentStatus {
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum DeploymentEnvironment {
  PRODUCTION
  STAGING
  CANARY
}

model Deployment {
  id                 String                @id @default(uuid()) @db.Uuid
  environment        DeploymentEnvironment @default(PRODUCTION)
  status             DeploymentStatus      @default(SUCCESS)
  serviceName        String                // e.g. "auth-gateway", "payment-service"
  version            String                // e.g. "v3.1.0", "sha-f9a8b7"
  commitSha          String?
  commitMessage      String?
  deployedAt         DateTime              @default(now())
  leadTimeMinutes    Int?                  // Commit-to-prod cycle latency
  deployedBy         String?
  metadata           Json?
  createdAt          DateTime              @default(now())

  orgId              String                @db.Uuid
  organization       Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)

  workspaceId        String?               @db.Uuid
  workspace          Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  incidents          Incident[]

  @@index([orgId, environment, deployedAt])
  @@index([orgId, serviceName])
  @@map("deployments")
}

enum IncidentSeverity {
  SEV1_CRITICAL
  SEV2_HIGH
  SEV3_MEDIUM
  SEV4_LOW
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MITIGATED
  RESOLVED
}

model Incident {
  id                  String            @id @default(uuid()) @db.Uuid
  title               String
  description         String?           @db.Text
  severity            IncidentSeverity  @default(SEV2_HIGH)
  status              IncidentStatus    @default(RESOLVED)
  serviceName         String
  startedAt           DateTime
  mitigatedAt         DateTime?
  resolvedAt          DateTime?
  recoveryTimeMinutes Int?              // MTTR latency
  rootCause           String?           @db.Text
  isChangeFailure     Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  deploymentId        String?           @db.Uuid
  deployment          Deployment?       @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  orgId               String            @db.Uuid
  organization        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([orgId, severity])
  @@map("incidents")
}

model DevExPulse {
  id                 String          @id @default(uuid()) @db.Uuid
  score              Int             // 1 to 5 overall health/sentiment
  frictionArea       String?         // 'CODE_REVIEW', 'CI_CD_BUILD', 'ON_CALL', 'REQUIREMENTS', 'MEETINGS', 'NONE'
  focusTimeHours     Float?          // Hours of uninterrupted flow time this week
  onCallBurden       Int?            // 1 (Low) to 5 (Overwhelmed)
  notes              String?         @db.Text
  isAnonymous        Boolean         @default(true)
  submittedAt        DateTime        @default(now())

  userId             String?         @db.Uuid
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  orgId              String          @db.Uuid
  organization       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  teamId             String?         @db.Uuid
  team               Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([orgId, submittedAt])
  @@map("devex_pulses")
}

enum OkrLevel {
  ORGANIZATION
  WORKSPACE
  TEAM
}

enum OkrStatus {
  ON_TRACK
  AT_RISK
  BEHIND
  COMPLETED
  CANCELLED
}

model Objective {
  id                 String          @id @default(uuid()) @db.Uuid
  title              String
  description        String?         @db.Text
  level              OkrLevel        @default(WORKSPACE)
  status             OkrStatus       @default(ON_TRACK)
  progressPercent    Float           @default(0.0)
  quarter            String          // e.g. "2026-Q4"
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  orgId              String          @db.Uuid
  organization       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  workspaceId        String?         @db.Uuid
  workspace          Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  keyResults         KeyResult[]

  @@index([orgId, quarter, status])
  @@map("objectives")
}

model KeyResult {
  id                 String          @id @default(uuid()) @db.Uuid
  title              String
  targetValue        Float
  currentValue       Float           @default(0)
  initialValue       Float           @default(0)
  unit               String          @default("hours")
  status             OkrStatus       @default(ON_TRACK)
  progressPercent    Float           @default(0.0)
  ownerName          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  objectiveId        String          @db.Uuid
  objective          Objective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
  @@map("key_results")
}

// ==========================================
// V3 PHASE 5: ENTERPRISE SECURITY & COMPLIANCE
// ==========================================

model AuditLog {
  id           String       @id @default(uuid()) @db.Uuid
  action       String       // e.g. "USER_LOGIN", "ROLE_CHANGE", "ORGANIZATION_UPDATE", "INTEGRATION_CREATE", "DATA_PURGE", "GDPR_FORGET", etc.
  entityType   String       // e.g. "User", "Organization", "Team", "Integration", "Deployment", "RetentionPolicy"
  entityId     String?
  ipAddress    String?
  userAgent    String?
  payload      Json?        // Change delta / metadata
  prevHash     String       // SHA-256 hash of previous log in this org (or 'GENESIS')
  hash         String       // SHA-256 hash of (prevHash + orgId + action + entityType + entityId + timestamp + JSON(payload))
  createdAt    DateTime     @default(now())

  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId       String?      @db.Uuid
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, action])
  @@index([orgId, entityType])
  @@map("audit_logs")
}

model RetentionPolicy {
  id             String       @id @default(uuid()) @db.Uuid
  entityType     String       // "AUDIT_LOGS", "INTEGRATION_EVENTS", "INBOX_ITEMS", "TASKS", "MEETINGS"
  retentionDays  Int          @default(365) // 30, 90, 180, 365, 2555 (7 years)
  action         String       @default("DELETE") // "DELETE", "ANONYMIZE", "ARCHIVE"
  isActive       Boolean      @default(true)
  legalHold      Boolean      @default(false) // When true, purges are strictly blocked
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orgId          String       @db.Uuid
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType])
  @@map("retention_policies")
}

model ComplianceExport {
  id             String       @id @default(uuid()) @db.Uuid
  type           String       // "GDPR_TAKEOUT", "LEGAL_DISCOVERY", "AUDIT_REPORT"
  status         String       @default("COMPLETED") // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  downloadUrl    String?
  filter         Json?        // Target User / criteria
  fileSizeBytes  Int?
  recordCount    Int          @default(0)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  orgId          String       @db.Uuid
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  requestedById  String?      @db.Uuid
  requestedBy    User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("compliance_exports")
}

// ==========================================
// V3 PHASE 6: AI DECISION INTELLIGENCE & VECTOR MEMORY
// ==========================================

model SemanticMemory {
  id           String       @id @default(uuid()) @db.Uuid
  entityType   String       // "DECISION", "NOTE", "INCIDENT", "MEETING", "RFC"
  entityId     String?
  title        String
  content      String       @db.Text
  embedding    Float[]      // Normalized vector embedding for cosine similarity search
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType])
  @@index([orgId, createdAt])
  @@map("semantic_memories")
}

model OneOnOneAgenda {
  id           String       @id @default(uuid()) @db.Uuid
  status       String       @default("DRAFT") // "DRAFT", "FINALIZED", "COMPLETED"
  scheduledFor DateTime?
  talkingPoints Json        // Array of recommended items { title, category, reason, sourceCitation }
  actionItems  Json?        // Action items agreed upon
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  leadId       String       @db.Uuid
  lead         User         @relation("AgendaLead", fields: [leadId], references: [id], onDelete: Cascade)

  memberId     String       @db.Uuid
  member       User         @relation("AgendaMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId, leadId, memberId])
  @@map("one_on_one_agendas")
}

model QuarterlyReview {
  id                  String       @id @default(uuid()) @db.Uuid
  quarter             String       // e.g. "2026-Q4"
  title               String
  executiveSummary    String       @db.Text
  doraSummary         Json         // DF, LTTC, CFR, MTTR, performance tier
  okrSummary          Json         // Objectives achieved, completion %, key results
  reliabilitySummary  Json         // Outages, SEV-1/SEV-2 count, MTTR trends
  devexSummary        Json         // Morale score, flow hours, solved friction
  strategicPriorities Json         // Next quarter strategic focus initiatives
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  orgId               String       @db.Uuid
  organization        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  generatedById       String?      @db.Uuid
  generatedBy         User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([orgId, quarter])
  @@map("quarterly_reviews")
}




