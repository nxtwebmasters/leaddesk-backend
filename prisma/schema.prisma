generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum OrgRole {
  OWNER
  ORG_ADMIN
  DIRECTOR
  MANAGER
  MEMBER
  GUEST_STAKEHOLDER
  COMPLIANCE_AUDITOR
}

enum TaskStatus {
  INBOX
  PLANNED
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  TASK
  DELEGATED
  FOLLOW_UP
  PERSONAL
}

enum InboxItemType {
  TASK
  NOTE
  REMINDER
  MEETING
  DISCUSSION
  IDEA
  DECISION
  FOLLOW_UP
}

enum InboxItemStatus {
  NEW
  PROCESSED
  DISMISSED
}

enum FollowUpStatus {
  OPEN
  WAITING
  COMPLETED
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

enum CalendarEventType {
  MEETING
  PERSONAL
  TASK
  REMINDER
  OTHER
}

// ==========================================
// MODELS
// ==========================================

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  passwordHash   String
  displayName    String
  timezone       String          @default("Asia/Karachi")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  refreshTokens  RefreshToken[]
  inboxItems     InboxItem[]
  tasks          Task[]
  followUps      FollowUp[]
  meetings       Meeting[]
  notes          Note[]
  contacts       Contact[]
  calendarEvents    CalendarEvent[]
  reminders         Reminder[]
  attachments       Attachment[]
  pushSubscriptions PushSubscription[]
  notifications     AppNotification[]
  decisions         Decision[]
  orgMemberships    OrgMembership[]
  ledTeams          Team[]              @relation("TeamLead")

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model InboxItem {
  id                  String          @id @default(uuid()) @db.Uuid
  content             String          @db.Text
  type                InboxItemType   @default(NOTE)
  status              InboxItemStatus @default(NEW)
  source              String?         @default("WEB")
  idempotencyKey      String?         @unique
  convertedEntityType String?
  convertedEntityId   String?         @db.Uuid
  capturedAt          DateTime        @default(now())
  processedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  userId              String          @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, capturedAt])
  @@map("inbox_items")
}

model Task {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  description    String?         @db.Text
  status         TaskStatus      @default(INBOX)
  priority       Priority        @default(MEDIUM)
  type           TaskType        @default(TASK)
  dueAt          DateTime?
  completedAt    DateTime?
  assigneeName   String?
  assigneeEmail  String?
  sourceUrl      String?
  sourceSystem   String?
  sortOrder      Int             @default(0)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  contactId      String?         @db.Uuid
  contact        Contact?        @relation("ContactTasks", fields: [contactId], references: [id], onDelete: SetNull)

  workspaceId    String?         @db.Uuid
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  subtasks       Subtask[]
  followUps      FollowUp[]
  meetingActions MeetingAction[]
  tags           TaskTag[]
  reminders      Reminder[]
  attachments    Attachment[]

  @@index([userId, status, dueAt])
  @@index([userId, priority])
  @@index([userId, updatedAt])
  @@map("tasks")
}

model Subtask {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  isCompleted Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskId      String   @db.Uuid
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@map("subtasks")
}

model FollowUp {
  id              String         @id @default(uuid()) @db.Uuid
  contactName     String
  organization    String?
  subject         String
  context         String?        @db.Text
  expectedOutcome String?        @db.Text
  status          FollowUpStatus @default(OPEN)
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contactId       String?        @db.Uuid
  contact         Contact?       @relation("ContactFollowUps", fields: [contactId], references: [id], onDelete: SetNull)

  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId          String?        @db.Uuid
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  meetingId       String?        @db.Uuid
  meeting         Meeting?       @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId, status, nextFollowUpAt])
  @@map("follow_ups")
}

model Meeting {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  description    String?         @db.Text
  status         MeetingStatus   @default(SCHEDULED)
  startedAt      DateTime
  endedAt        DateTime?
  location       String?
  meetingUrl     String?
  participants   Json?
  notesMarkdown  String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspaceId    String?         @db.Uuid
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  actions        MeetingAction[]
  decisions      Decision[]
  followUps      FollowUp[]
  reminders      Reminder[]
  attachments    Attachment[]

  @@index([userId, startedAt])
  @@map("meetings")
}

model MeetingAction {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  ownerName   String?
  dueAt       DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meetingId   String    @db.Uuid
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  taskId      String?   @db.Uuid
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("meeting_actions")
}

model Decision {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?  @db.Text
  decidedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  meetingId   String?  @db.Uuid
  meeting     Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, decidedAt])
  @@index([userId, decidedAt])
  @@map("decisions")
}

model Note {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  content     String       @db.Text
  isPinned    Boolean      @default(false)
  sourceUrl   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspaceId String?      @db.Uuid
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags        NoteTag[]
  attachments Attachment[]

  @@index([userId, updatedAt])
  @@map("notes")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now())

  tasks     TaskTag[]
  notes     NoteTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @db.Uuid
  tagId  String @db.Uuid

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model NoteTag {
  noteId String @db.Uuid
  tagId  String @db.Uuid

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

model CalendarEvent {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  description String?           @db.Text
  eventType   CalendarEventType @default(OTHER)
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean           @default(false)
  sourceUrl   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@map("calendar_events")
}

model Reminder {
  id        String         @id @default(uuid()) @db.Uuid
  title     String
  remindAt  DateTime
  status    ReminderStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime       @default(now())

  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId    String?        @db.Uuid
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  meetingId String?        @db.Uuid
  meeting   Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([userId, status, remindAt])
  @@map("reminders")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  storageKey String   @unique
  createdAt  DateTime @default(now())

  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId     String?  @db.Uuid
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  noteId     String?  @db.Uuid
  note       Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  meetingId  String?  @db.Uuid
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("attachments")
}

model Contact {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  role         String?    // e.g. Senior Frontend Dev, QA Lead, DevOps Engineer, Client
  organization String?    // e.g. Internal Team, Cloud Team, Client Org
  email        String?
  phone        String?
  handle       String?    // @slack or @teams username
  notes        String?    @db.Text
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks        Task[]     @relation("ContactTasks")
  followUps    FollowUp[] @relation("ContactFollowUps")

  @@index([userId, name])
  @@map("contacts")
}

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AppNotification {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String   @db.Text
  type      String   @default("GENERAL") // DAILY_KICKOFF, MEETING_ALERT, FOLLOWUP_SWEEP, REMINDER, GENERAL
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("app_notifications")
}

// ==========================================
// V3 ENTERPRISE MULTI-TENANCY & RBAC
// ==========================================

model Organization {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String          @unique
  domain         String?
  logoUrl        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspaces     Workspace[]
  memberships    OrgMembership[]
  invitations    OrgInvitation[]

  @@map("organizations")
}

model Workspace {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  slug           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orgId          String          @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  parentId       String?         @db.Uuid
  parent         Workspace?      @relation("WorkspaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Workspace[]     @relation("WorkspaceHierarchy")

  teams          Team[]
  tasks          Task[]
  meetings       Meeting[]
  notes          Note[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("workspaces")
}

model Team {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspaceId    String          @db.Uuid
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  leadUserId     String?         @db.Uuid
  leadUser       User?           @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)

  memberships    TeamMembership[]

  @@index([workspaceId])
  @@map("teams")
}

model OrgMembership {
  id             String          @id @default(uuid()) @db.Uuid
  role           OrgRole         @default(MEMBER)
  title          String?
  department     String?
  joinedAt       DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orgId          String          @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  reportsToId    String?         @db.Uuid
  reportsTo      OrgMembership?  @relation("ReportingLine", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports  OrgMembership[] @relation("ReportingLine")

  teamMemberships TeamMembership[]

  @@unique([orgId, userId])
  @@index([orgId, role])
  @@index([reportsToId])
  @@map("org_memberships")
}

model TeamMembership {
  id             String          @id @default(uuid()) @db.Uuid
  isTechLead     Boolean         @default(false)
  joinedAt       DateTime        @default(now())

  teamId         String          @db.Uuid
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  membershipId   String          @db.Uuid
  orgMembership  OrgMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@map("team_memberships")
}

model OrgInvitation {
  id             String          @id @default(uuid()) @db.Uuid
  email          String
  role           OrgRole         @default(MEMBER)
  token          String          @unique
  expiresAt      DateTime
  invitedById    String          @db.Uuid
  createdAt      DateTime        @default(now())

  orgId          String          @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@map("org_invitations")
}
